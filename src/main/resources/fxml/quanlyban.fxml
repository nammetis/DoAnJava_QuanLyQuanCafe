<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.doanjava_quanlyquancafe.QuanLyBanController" spacing="10.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <Label text="SƠ ĐỒ BÀN" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #5D4037;" />

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <FlowPane fx:id="paneBan" hgap="15.0" vgap="15.0" style="-fx-padding: 20; -fx-hgap: 20; -fx-vgap: 20;">
        </FlowPane>
    </ScrollPane>
</VBox>