<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.doanjava_quanlyquancafe.MenuController" style="-fx-padding: 20; -fx-spacing: 15;">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <Label text="DANH SÁCH ĐỒ UỐNG" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #5D4037;" />
    <TableView fx:id="tblMenu" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colMStt" text="STT" prefWidth="50.0" />
            <TableColumn fx:id="colMTen" text="Tên Đồ Uống" prefWidth="250.0" />
            <TableColumn fx:id="colMGia" text="Giá Bán" prefWidth="100.0" />
        </columns>
    </TableView>
    <HBox spacing="15.0" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
    <Button text="Thêm Món" onAction="#handleThem" style="-fx-background-color: #43A047;" />
    <Button text="Sửa Món" onAction="#handleSua" style="-fx-background-color: #FB8C00;" />
    <Button text="Xóa Món" onAction="#handleXoa" style="-fx-background-color: #E53935;" />
    </HBox>
</VBox>